{
  "name": "percival-character-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ficha mobile de Percival: Juramento de Sangue, dados físicos e sessão local.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --import tsx --test tests/app.test.tsx",
    "test:rules": "node --test tests/firebase.rules.emulator.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "ficha": "node scripts/show-percival.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
